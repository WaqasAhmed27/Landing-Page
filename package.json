{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && npm run prepare:worker-assets",
    "prepare:worker-assets": "node scripts/prepare-worker-assets.mjs",
    "db:migrate:remote": "npx wrangler d1 execute taptile-waitlist --remote --file=migrations/0001_create_waitlist_submissions.sql",
    "db:list:remote": "npx wrangler d1 execute taptile-waitlist --remote --command \"SELECT id, email, business_name, city, pos_software, source, submitted_at, email_status FROM waitlist_submissions ORDER BY submitted_at DESC;\"",
    "deploy:worker": "npm run build && npx wrangler deploy --config wrangler.jsonc",
    "start": "npm run build && node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "og:image": "node scripts/generate-og-image.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
